# Generic OpenAI-compatible configuration
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Optional explicit provider label
# LLM_PROVIDER=deepseek

# Alternative OpenAI-style keys are also supported:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional vision model configuration for image eval inputs.
# If these are empty, image eval falls back to the normal LLM/DashScope settings.
# Verified available on MaaS DashScope instances: qwen3-vl-plus (通用视觉).
# qwen-vl-ocr / qwen-vl-ocr-2025-11-20 仅 OCR，不能用于通用事件识别。
# qwen3-vl-flash 在多数 MaaS 实例上 404，请使用 qwen3-vl-plus。
VISION_LLM_API_KEY=
VISION_LLM_BASE_URL=
VISION_LLM_MODEL=qwen3-vl-plus
VISION_LLM_PROVIDER=

# OCR is a future fallback path. The first implementation does not require local OCR.
OCR_ENABLED=true
